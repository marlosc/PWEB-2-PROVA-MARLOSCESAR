<h1>Categorias</h1>
<p><a href="/categorias/nova">Nova Categoria</a></p>
<table>
  <thead><tr><th>ID</th><th>Nome</th></tr></thead>
  <tbody>
    <% categorias.forEach((categoria) => { %>
      <tr>
        <td>#<%= categoria.id %></td>
        <td><%= categoria.nome %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
