<h1>Produtos</h1>
<p><a href="/produtos/novo">Novo Produto</a></p>
<table>
  <thead><tr><th>ID</th><th>Nome</th><th>Preço</th><th>Categoria</th></tr></thead>
  <tbody>
    <% produtos.forEach((produto) => { %>
      <tr>
        <td>#<%= produto.id %></td>
        <td><%= produto.nome %></td>
        <td>R$ <%= Number(produto.preco).toFixed(2).replace('.', ',') %></td>
        <td><%= produto.categoria.nome %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
